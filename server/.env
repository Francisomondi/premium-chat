# ============================================================
# M-PESA TRANSACTION STATUS
# ============================================================

MPESA_TRANSACTION_STATUS_ENABLED=false

MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=

# Safaricom public certificate, PEM format.
# Use the certificate appropriate to the environment.
MPESA_PUBLIC_CERTIFICATE=

MPESA_TRANSACTION_STATUS_RESULT_URL=
MPESA_TRANSACTION_STATUS_TIMEOUT_URL=

# M-Pesa Transaction Status
MPESA_TRANSACTION_STATUS_ENABLED=false


MPESA_SECURITY_CREDENTIAL=

# ============================================================
# AUTHENTICATED M-PESA MERCHANT RECONCILIATION
# ============================================================

MPESA_MERCHANT_RECONCILIATION_ENABLED=false

MPESA_AUTOMATIC_SETTLEMENT_ENABLED=false

MPESA_MERCHANT_SOURCE_TYPE=SAFARICOM_BUSINESS_API

# ============================================================
# STEP 18.31 — PAYMENT RECOVERY
# ============================================================

PAYMENT_RECOVERY_ENABLED=false

PAYMENT_RECOVERY_BATCH_SIZE=25

PAYMENT_RECOVERY_MIN_AGE_MINUTES=5

# ============================================================
# STEP 18.32 — SUBSCRIPTION LIFECYCLE
# ============================================================

SUBSCRIPTION_EXPIRATION_JOB_ENABLED=false

SUBSCRIPTION_EXPIRATION_BATCH_SIZE=100

# ============================================================
# M-PESA STK RECONCILIATION WORKER
# ============================================================


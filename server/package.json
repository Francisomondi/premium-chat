    "test:auth": "node --env-file=.env --test tests/integration/auth.session.test.js",
    "subscriptions:expire": "node --env-file=.env src/workers/subscriptionExpiration.worker.js",
    "payments:reconcile": "node --env-file=.env src/workers/mpesaReconciliation.worker.js"
